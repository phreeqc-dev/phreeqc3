------------------------------------
Reading input data for simulation 1.
------------------------------------

	DATABASE ../database/phreeqc.dat
	SELECTED_OUTPUT 101
	    file                 CO2_anal_101.sel
	USER_PUNCH 101
	    headings Mu SC
	    start
	10 PUNCH STR_F$(MU, 20, 12)
	20 PUNCH STR_F$(SC, 20, 10)
	    end
	SOLUTION 1
	PHASES
	CO2(g)
		CO2 = CO2
		log_k	-1.468
		delta_h  -4.776 kcal
		analytical_expression	108.3865	0.01985076	-6919.53	-40.45154	669365.0
		t_c  304.2 # critical T, K
		p_c   72.80 # critical P, atm
		omega 0.225 #  acentric factor
	vm   2.6050944E+01  9.3248418E-03  -7.4742551E-02   0.0000000E+00
	EQUILIBRIUM_PHASES
	 CO2(g) -1
	REACTION_TEMPERATURE
	 5 200 in 10
	USER_GRAPH
	 -axis_titles "temp / oC" "CO2 / (mol/kgw)"
	 -chart_title "P_CO2 = 0.1 atm"
	 -axis_scale x_axis 0 200
	 -headings tc old
	 10 x = tc
	 20 graph_x x
	 30 graph_y tot("C(4)")
	 -end
	END
