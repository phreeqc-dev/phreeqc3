	80 if cell_no = 32 then print 'AARD for SC of NaCl   ' + str_f$((get(1) / (get(2) )) * 1e2, 0, 2) + ' % for', get(2), 'samples, ' + str_e$(get(3), 0, 2) + ' - ' + str_e$(Cl, 0, 2) + ' mol/kgw' : put(get(1) + get(11), 11) : put(get(2) + get(12), 12)
	END
