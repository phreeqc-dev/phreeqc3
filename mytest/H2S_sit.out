	SOLUTION_SPECIES
	H2Sg = H2Sg # H2S
		dw	 2.1e-9
	        vm  1.39  28.3  0  -7.22  -0.59 # ref. 1 + Hnedkovsky et al., 1996, JCT 28, 125
	H2Sg = HSg- + H+
		log_k	-6.994
