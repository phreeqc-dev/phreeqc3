	50  pc = pressure : v = (vm("H2Sg") * mol("H2Sg") + vm("(H2Sg)2") * mol("(H2Sg)2") + vm("HSg-") * mol("HSg-")) / tot("Sg") : dif = (v / mo(i) - 1) * 1
