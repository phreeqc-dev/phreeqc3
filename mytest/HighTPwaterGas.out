	USE SOLUTION 1
	REACTION 1
	    CO2(g)     1
	    1 moles in 100 steps
	GAS_PHASE 1
	    fixed_pressure
	    pressure 600
	    volume 1e-9
	    temperature 65
	     CO2(g) 0
	     H2O(g) 0
