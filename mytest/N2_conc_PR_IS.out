	DATABASE ../database/phreeqc.dat
	SELECTED_OUTPUT 101
	    file                 N2_conc_PR_IS_101.sel
	USER_PUNCH 101
	    headings Mu SC
	    start
	10 PUNCH STR_F$(MU, 20, 12)
	20 PUNCH STR_F$(SC, 20, 10)
	    end
	SOLUTION 1
	N 1 N2(g) 1.4
	PHASES
	N2(g)
		N2 = N2
		log_k		 -3.1864
		analytical_expression -58.453 1.81800E-03  3199  17.909 -27460
		t_c  126.2 # critical T, K
		p_c   33.50 # critical P, atm
		omega 0.039 # Pitzer acentric factor
	SELECTED_OUTPUT
	 reset false
	 file 25.prn
	USER_PUNCH
	  1 sc$ = chr$(59)
	 10 for i = 1.1 to 820 step 20
	 20   punch 'SOLUTION 1' + sc$ + ' -temp 25' + sc$ + ' pH 3 charge' + EOL$ + 'N 1 N2(g) ' + str$(log10(i)) + EOL$ + '-pressure ' + str$(i) + EOL$ + 'END' + EOL$
	 30 next i
	END
