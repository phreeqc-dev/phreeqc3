	SAVE gas_phase 8
	DUMP
	 file dump
	 -gas_phase 8
	SELECTED_OUTPUT
	 reset false
	 file gas_8
	 high_precision true
	USER_PUNCH
	  1 if step_no = 0 then goto 100
	  2 sc$ = CHR$(59)
	 10 punch 'GAS_PHASE_MODIFY 8' + EOL$
	 30 punch  '  -volume             1' + EOL$
	 40 punch '-comp  CO2(g)' + EOL$
	 60 punch '-moles ' + STR$(1e8 * GAS("CO2(g)")) + EOL$
	 70 punch '-comp N2(g) ' + sc$ + '-moles ' + STR$(1e8 * GAS("N2(g)")) + EOL$
	 100 end
	END
