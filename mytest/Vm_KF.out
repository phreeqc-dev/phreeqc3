	10 data 0, 1.410000, 1.390000, 2.760000, 2.760000, 5.450000, 5.430000, 13.320000, 13.290000, 26.180000, 26.190000, 55.070000, 55.080000, 139.850000, 139.910000, 
	20 dim d(15)
