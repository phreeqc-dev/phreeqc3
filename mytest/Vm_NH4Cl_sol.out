	USER_GRAPH
	 -headings 40.C_1.atm
	 -axis_titles "NH4Cl / (mol/kg H2O)" "NH4Cl molar volume / (cm3/mol)"
	10 data 0, 36.933000, 36.829000, 37.148000, 37.772000, 36.953000, 37.452000, 37.690000, 38.045000, 38.381000, 38.791000, 38.982000, 39.620000, 
	20 dim d(13)
