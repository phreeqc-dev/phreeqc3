	10 data 0, 36.847000, 36.951000, 37.174000, 37.860000, 37.014000, 37.465000, 38.600000, 37.748000, 38.700000, 38.115000, 38.459000, 38.885000, 38.859000, 39.018000, 39.080000, 39.159000, 39.335000, 39.736000, 39.448000, 39.554000, 39.673000, 39.768000, 39.875000, 39.963000, 40.062000, 
	20 dim d(26)
