	USE solution 1
	KINETICS
		cvode
		steps 20 in 10 steps
	     CaX2
		  formula   Ca  1  
		  parms   1           # rate constant in per day
	          m 0
	     MgX2
		  formula   Mg  1  
		  parms   1           # rate constant in per day
	          m 0
	     KX
		  formula   K  1  
		  parms   1           # rate constant in per day
	          m 0
	     HX
		  formula   H  1  
		  parms   1           # rate constant in per day
	          m 0
	     NaX
		  formula   Na  1 
	          m 1e-3
	INCREMENTAL_REACTIONS
	PRINT
		warnings 1
	USER_PRINT
	10 sites = GET(1)
	20 print "Total equivalents:         ", sites
	40 print "equiv frac NaX:            ", 10^get(1,1)
	50 print "equiv frac CaX2:           ", 10^get(2,1)
	60 print "equiv frac MgX2:           ", 10^get(3,1)
	70 print "equiv frac KX:             ", 10^get(4,1)
	80 print "equiv frac HX:             ", 10^get(5,1)
	SELECTED_OUTPUT
		file kinex.sel
		reset false
		step
	USER_PUNCH
	heading Na_eq_frac Ca_eq_frac Mg_eq_frac K_eq_frac H_eq_frac
	40 PUNCH 10^get(1,1)
	50 PUNCH 10^get(2,1)
	60 PUNCH 10^get(3,1)
	70 PUNCH 10^get(4,1)
	80 PUNCH 10^get(5,1)
	END
