	4 	1.83e-1	1 charge	1.0152	#     29400
	5 	2.30e-1	1 charge	1.0194	#     36100
	6 	2.77e-1	1 charge	1.0236	#     42600
	7 	3.24e-1	1 charge	1.0278	#     48900
