	  64 if step_no = 9 then print 'La(NO3)3, AARD: ' + str_f$((get(1) / (get(2) )) * 100, 0, 2) + ' %'
	  70 if step_no = 1 then xy = 0 else xy = 120
	  80 if step_no < 3 then plot_xy xy, xy, color = black, symbol = None
	END
