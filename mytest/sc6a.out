	DATABASE ../database/phreeqc.dat
	SELECTED_OUTPUT 101
	    file                 sc6a_101.sel
	USER_PUNCH 101
	    headings Mu SC
	    start
	10 PUNCH STR_F$(MU, 20, 12)
	20 PUNCH STR_F$(SC, 20, 10)
	    end
	SOLUTION_SPECIES
	 Na+ = Na+
	 log_k 0
	 gamma 1e10 0
	 Ca+2 = Ca+2
	 log_k 0
	 gamma 1e10 0
	 Cl- = Cl-
	 log_k 0
	 gamma 1e10 0
	 H2O + 0.01e- = H2O-0.01
	 log_k -9
	SURFACE_MASTER_SPECIES
	 Sua Sua
	 Sub Sub
	 Suc Suc
	SURFACE_SPECIES
	 Sua = Sua
	 log_k 0
	 Sub = Sub
	 log_k 0
	 Suc = Suc
	 log_k 0
	SURFACE_MASTER_SPECIES /* defined sorbed form of Hfo = Sorbedhfo */
	 Sorbedhfo_s Sorbedhfo_sOH
	 Sorbedhfo_w Sorbedhfo_wOH
	SURFACE_SPECIES
	 Sorbedhfo_sOH = Sorbedhfo_sOH
	 log_k 0.0
	 Sorbedhfo_sOH + H+ = Sorbedhfo_sOH2+
	 log_k 7.29
	 Sorbedhfo_sOH = Sorbedhfo_sO- + H+
	 log_k -8.93
	 Sorbedhfo_wOH = Sorbedhfo_wOH
	 log_k 0.0
	 Sorbedhfo_wOH + H+ = Sorbedhfo_wOH2+
	 log_k 7.29
	 Sorbedhfo_wOH = Sorbedhfo_wO- + H+
	 log_k -8.93
	 Sorbedhfo_sOH + Ca+2 = Sorbedhfo_sOHCa+2
	 log_k 4.97
	 Sorbedhfo_wOH + Ca+2 = Sorbedhfo_wOCa+ + H+
	 log_k -5.85
	 Sorbedhfo_sOH + Zn+2 = Sorbedhfo_sOZn+ + H+
	 log_k 0.99
	 Sorbedhfo_wOH + Zn+2 = Sorbedhfo_wOZn+ + H+
	 log_k -1.99
	SOLUTION 0-21
	END          
