DATABASE ../database/phreeqc.dat
#PRINT; -reset false
SELECTED_OUTPUT 101
    -file                visc_anions_tc_101.sel
USER_PUNCH 101
    -headings Mu SC Viscosity
    -start
10 PUNCH STR_F$(MU, 20, 12)
20 PUNCH STR_F$(SC, 20, 10)
30 PUNCH STR_F$(VISCOS, 20, 10)
    -end
#PRINT; -reset false

SOLUTION 1
pH 7 charge
END

USE solution 1; Reaction 1; KF; 5
REACTION_TEMPERATURE 1; 0 300 in 31
USER_GRAPH
-headings tc viscos_0 ==NEW== KF
-axis_scale	x_axis 140 300
-axis_scale	y_axis 0 0.6
-axis_titles "temperature / ÂºC" "viscosity / mPaâ€¢s"
-chart_title "Viscosity of anions f(T)"
10 graph_x tc : graph_y viscos_0 #- get(step_no) : Cl = vm("Cl-")
20 plot_xy tc, viscos_0, line_width	= 0 symbol	= None
30 plot_xy tc, viscos, line_width	= 2
END

